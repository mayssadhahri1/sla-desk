{
  "name": "sla-desk",
  "version": "1.0.0",
  "description": "Plateforme de support (helpdesk) avec gestion des SLA, rôles et tableau de bord",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "seed": "tsx --disable-warning=ExperimentalWarning src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
