# Copier ce fichier en .env puis adapter les valeurs
PORT=3000
# Chemin de la base SQLite (":memory:" pour une base temporaire)
DATABASE_PATH=./sla-desk.db
# Clé secrète pour signer les jetons JWT (à changer en production !)
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=8h
# Créer les comptes et tickets de démonstration (true / false)
SEED_DEMO=true
